msgstr "``<= 30 %``"

#: ../../source/usage.rst:298 2dfee531b73a492dab32411c33f34022
msgid "drift -- worth a look, not evidence of anything by itself"
msgstr "漂移——值得看一眼，但本身不构成任何证据"

#: ../../source/usage.rst:299 f319a059d27b48f397566e8361f52eaf
msgid "``1.3x .. 2.0x``"
