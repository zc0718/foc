+def _chunk_characters(text: str) -> dict:
+    """The characters that carry meaning: no whitespace, no line-stars, no language tags."""
+    _clean = re.sub(r"\[(?:en|zh)\]", "", text)
+    _counts: dict = {}
+    for _c in _clean:
+        if _c.isspace() or _c == '*':
+            continue
