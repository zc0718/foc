{
  "name": "fcpp",
  "version": "0.0.0-development",
  "private": true,
  "description": "Node-side tooling for fcpp: commit lint gates and semantic-release (private, never published to npm).",
  "license": "Apache-2.0",
  "scripts": {
    "lint:megalinter": "bash .github/misc/run-megalinter.sh",
    "lint:megalinter:fix": "bash .github/misc/run-megalinter.sh --fix",
    "skills:validate": "python3 .github/skills/_shared/skillkit/cli.py validate --strict",
    "skills:sync": "python3 .github/skills/_shared/skillkit/cli.py sync",
    "skills:sync:all": "python3 .github/skills/_shared/skillkit/cli.py sync --harness all",
    "skills:check": "python3 .github/skills/_shared/skillkit/cli.py sync --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "ajv-cli": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "mega-linter-runner": "^10.0.0",
    "semantic-release": "^24.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
