{
  "name": "foc",
  "target": "auto",
  "version": "0.1.0",
  "team": "HeT-FTI",
  "license": "Apache-2.0",
  "description": "A hardware-agnostic FOC algorithm core: C++17 template policy kernel with a stable C11 ABI path",
  "authors": ["Chen Zhang <chen2.zhang@szhittech.com>"],
  "maintainers": ["Chen Zhang <chen2.zhang@szhittech.com>"],
  "topics": ["foc", "motor-control", "embedded", "library", "test"],
  "url": "https://github.com/HeT-FTI/foc.git",
  "homepage": "https://github.com/HeT-FTI",
  "cmake_version": "4.2.3",
  "build_cppstd": "17",
  "build_cstd": "11",
  "build_type": "Debug",
  "activate_code_coverage": true,
  "is_shared": false,
  "is_header": false,
  "generate_modules_inplace": false,
  "std_modules": "iostream",
  "user_modules": "",
  "dependencies": {
    "common": {},
    "c": {},
    "cpp": {"etl": ["etl::etl"]},
    "infra": {"GTest": ["gtest::gtest"]}
  },
  "baremetal_white_list": ["etl", "ArduinoJson"],
  "doc_languages": ["en", "zh"],
  "doc_versions": ["0.1.0"],
  "doc_doxygen_folders": ["include", "src", "docs/doxygen/dox"],
  "doc_doxygen_suffix": ["h", "c", "hpp", "cpp", "dox", "cxx"],
  "trigger_tests": true,
  "saving_tests_log": true,
  "enable_python_bindings": false,
  "workflow_triggers": {
    "build": true,
    "tests": true,
    "release": true,
    "docs": true,
    "security_scan": true,
    "cross_compile": true
  }
}