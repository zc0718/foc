# build system related
/.idea/
/cmake-build-debug/
.envs
node_modules/
__pycache__/
*.pyc

# process artifacts (audit/plan docs live in the working copy only)
/workspace/

# agent-skill adapter views (generated symlinks/junctions; canonical source is .github/skills)
# Default: .agents only. Optional: .claude / .codex via `sync --harness claude|codex`.
# No trailing slash: a POSIX view is a symlink, which a "dir/" pattern does not match.
# Regenerate with: python .github/skills/_shared/skillkit/cli.py sync
# This template keeps views as links. A repository created from it commits a
# byte-identical .agents/skills copy instead (see .github/workflows/sync-template.yml).
/.agents/skills
/.claude/skills
/.codex/skills
/.github/skills/_shared/.skillkit/

# .vscode/: the shared files ARE committed (extensions.json / settings.json / tasks.json);
# machine-local editor state stays out
.vscode/launch.json
.vscode/*.code-workspace
.vscode/ipch/

# doc system related
/docs/_cache/
/docs/doxygen/build/
/docs/sphinx/build/
/docs/sphinx/source/_static
/docs/sphinx/source/_templates

# test framework
/test_package/test/export/
/test_package/build/
CMakeUserPresets.json

# megalinter reports
/megalinter-reports/
mega-linter.log